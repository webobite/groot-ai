# .env.example — Copy this to .env and fill in your values
# cp k8s/.env.example k8s/.env

# ── GCP Project ──────────────────────────────────────
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ── GKE Cluster ──────────────────────────────────────
GKE_CLUSTER_NAME=groot-cluster
GKE_NAMESPACE=groot-inference
GKE_DEPLOYMENT_NAME=groot-vllm

# ── Service Account ──────────────────────────────────
GCP_SA_EMAIL=your-sa@your-project.iam.gserviceaccount.com
K8S_SA_NAME=groot-inference-sa

# ── Secrets ──────────────────────────────────────────
HF_TOKEN_SECRET_NAME=groot-hf-token
API_KEY_SECRET_NAME=groot-api-key

# ── Storage ──────────────────────────────────────────
GCS_MODEL_CACHE_BUCKET=your-model-cache-bucket

# ── Model Configuration ──────────────────────────────
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
VLLM_IMAGE=vllm/vllm-openai:v0.6.6
VLLM_GPU_MEMORY_UTIL=0.90
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=64
VLLM_DTYPE=half
VLLM_PORT=8000

# ── GPU Configuration ───────────────────────────────
GPU_TYPE=nvidia-l4
GPU_COUNT=1
